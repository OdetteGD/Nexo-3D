#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_lua = env_modules.Clone()
env_lua.Append(CPPPATH=["#thirdparty/lua"])
env_lua.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_lua.add_source_files(env.modules_sources, "editor/*.cpp")
lua_sources = [source for source in Glob("#thirdparty/lua/*.c") if source.name not in ("lua.c", "luac.c")]
env_lua.add_source_files(env.modules_sources, lua_sources)
